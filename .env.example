# EMPREST.AI - Front. Copie para .env e preencha. Nenhum valor real aqui.
# Tudo com VITE_ vai para o bundle do navegador: so chave publica.
# Na Vercel, cadastre as mesmas chaves no projeto do front (preview e production).

# Base da API (rota com prefixo /v1). Aponta para o back; o CORS_ORIGIN do back
# aponta de volta para a URL deste front.
VITE_API_URL="http://localhost:3000/v1"

# Supabase: somente login/sessao via supabase-js; dados SEMPRE via API.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<chave-publishable-ou-anon>"
